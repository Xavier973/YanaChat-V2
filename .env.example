# ==============================================================================
# YanaChat V2 - Configuration Environnement (EXEMPLE)
# ==============================================================================
# Copiez ce fichier en .env et remplissez les valeurs

# ------------------------------------------------------------------------------
# MISTRAL API (OBLIGATOIRE)
# ------------------------------------------------------------------------------
MISTRAL_API_KEY=your_api_key_here
MISTRAL_API_URL=https://api.mistral.ai/v1/chat/completions

# ------------------------------------------------------------------------------
# EMAIL SMTP - Signalement de conversations problématiques (OPTIONNEL)
# ------------------------------------------------------------------------------
# Pour Gmail : utilisez un "App Password" (https://myaccount.google.com/apppasswords)
# Voir docs_yanachat/SMTP_CONFIGURATION.md pour le guide complet

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre.email@gmail.com
SMTP_PASSWORD=xxxx_xxxx_xxxx_xxxx
REPORT_EMAIL=x.cuniberti@gmail.com

# ------------------------------------------------------------------------------
# PRODUCTION HTTPS (Traefik + Let's Encrypt)
# À configurer UNIQUEMENT pour docker-compose.prod.yml
# ------------------------------------------------------------------------------

# Domaine principal de l'application (ex: yanachat.votredomaine.com)
# DOMAIN=yanachat.example.com

# Domaine pour le dashboard Traefik (ex: traefik.votredomaine.com)
# TRAEFIK_DOMAIN=traefik.example.com

# Email pour Let's Encrypt (renouvellement automatique des certificats)
# ACME_EMAIL=votre.email@example.com

# BasicAuth pour sécuriser le dashboard Traefik (OPTIONNEL)
# Générer avec: htpasswd -nb admin votre_mot_de_passe
# TRAEFIK_AUTH=admin:$$apr1$$xyz...
